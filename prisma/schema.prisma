generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Person {
  id       String   @id @default(cuid())
  name     String
  colorTag String
  createdAt DateTime @default(now())

  tripParticipants TripParticipant[]
  expensePayments  ExpensePayment[]
  expenseShares    ExpenseShare[]
}

model Trip {
  id             String   @id @default(cuid())
  title          String
  destination    String
  startDate      DateTime
  endDate        DateTime
  coverImagePath String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  participants TripParticipant[]
  expenses     Expense[]
  planDays     PlanDay[]
  infoItems    InfoItem[]
}

model TripParticipant {
  tripId   String
  personId String

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  person Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([tripId, personId])
}

enum ExpenseCategory {
  SOUVENIRS
  KLEIDUNG
  ESSEN
  TRANSPORT
  UNTERKUNFT
  EINTRITTE
  SONSTIGES
}

model Expense {
  id          String          @id @default(cuid())
  tripId      String
  date        DateTime
  description String
  amount      Float
  currency    String          @default("EUR")
  category    ExpenseCategory
  createdAt   DateTime        @default(now())

  trip     Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payments ExpensePayment[]
  shares   ExpenseShare[]

  @@index([tripId])
}

/// Wer hat wie viel von dieser Ausgabe bezahlt (mehrere Personen möglich, z. B. "beide").
model ExpensePayment {
  expenseId   String
  personId    String
  paidAmount  Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([expenseId, personId])
}

model ExpenseShare {
  expenseId   String
  personId    String
  shareAmount Float

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  person  Person  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([expenseId, personId])
}

model PlanDay {
  id                String   @id @default(cuid())
  tripId            String
  date              DateTime
  accommodationName String?
  accommodationNote String?
  activities        String?

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, date])
}

enum InfoCategory {
  GEPAECK
  NOTFALL
  DOKUMENTE
  SONSTIGES
}

model InfoItem {
  id        String       @id @default(cuid())
  tripId    String
  category  InfoCategory
  title     String
  content   String
  createdAt DateTime     @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}
